# ==============================================================================
# HackerRank Orchestrate (September 2026) — Buy or Wait?
# AI Provider Configuration Example
#
# Copy this file to `code/.env` or `code/.env.local` (or set environment variables).
# Files are searched in both `code/` and the repository root.
# Note: `.env.local` takes precedence over `.env` for local developer overrides.
#
# The system supports multi-provider cascading fallback in the following priority:
# 1. Azure OpenAI -> 2. OpenAI -> 3. Google Gemini -> 4. Anthropic Claude
#
# If no API key is set or network is unreachable, the system automatically
# executes in deterministic mode using rule-based auditing and templates.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure OpenAI (Primary Provider)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ------------------------------------------------------------------------------
# 2. OpenAI (Secondary Provider)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
# Optional custom base URL / proxy / gateway (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ENDPOINT=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Google Gemini (Tertiary Provider)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
# Optional custom endpoint (defaults to https://generativelanguage.googleapis.com/v1beta/openai/)
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 4. Anthropic Claude (Quaternary Provider)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional custom endpoint / proxy (defaults to https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_ENDPOINT=https://api.anthropic.com
